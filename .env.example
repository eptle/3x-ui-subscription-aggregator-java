# Скопируй в .env и заполни: cp .env.example .env

# Пароль входа в админку (логин admin). Обязателен
ADMIN_PASSWORD=

# Внешний адрес агрегатора: из него строятся ссылки на подписку в админке
PUBLIC_URL=https://aggregator.example.com

# Необязательные
#ADMIN_USER=admin
#PROFILE_TITLE=VPN
#REFRESH_INTERVAL=5m
# Порт на 127.0.0.1, к которому проксирует nginx
#APP_PORT=8080
